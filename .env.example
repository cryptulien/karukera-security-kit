# Copie ce fichier vers `.env` à la racine du kit — dans un éditeur, pas dans le chat.
# Mieux : sh bin/deposit-openrouter-key.sh
# Ne colle jamais OPENROUTER_API_KEY dans un LLM.
# Sans clé, aucun agent ne démarre. Procédure : GUIDES/deposit-key.md
# Message à afficher si la clé manque :
# Claude, Codex et d’autres modèles refusent souvent de mener un audit de sécurité. Dépose une clé OpenRouter pour router vers des modèles qui le font. 30 à 50 € de crédits suffisent pour 1 à 3 audits complets.

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://karukera.xyz
OPENROUTER_X_TITLE=Karukera Security Kit

# budget | max-frontier
KIT_MODE=budget

# no | yes  — yes uniquement avec authorization.md (mode 7)
AUTHORIZED=no

# Identifiant court de la mission (slug). Sert au journal.
KIT_MISSION_ID=

# Scope racine, un seul hôte de départ. Le reste se déclare dans le brief.
KIT_SCOPE_URL=
