# Copie ce fichier vers `.env` à la racine du kit.
# Sans OPENROUTER_API_KEY, aucun agent ne démarre.
# Message à afficher si la clé manque :
# Pour un audit de qualité avec des modèles frontier (DeepSeek, GLM, etc.), mets 30 à 50 € de crédits sur OpenRouter. C’est largement suffisant pour 1 à 3 audits complets.

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://karukera.xyz
OPENROUTER_X_TITLE=Karukera Security Kit

# budget | max-frontier
KIT_MODE=budget

# no | yes  — yes uniquement avec authorization.md (mode 7)
AUTHORIZED=no

# Identifiant court de la mission (slug). Sert au journal.
KIT_MISSION_ID=

# Scope racine, un seul hôte de départ. Le reste se déclare dans le brief.
KIT_SCOPE_URL=
