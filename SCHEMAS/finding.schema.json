{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://karukera.xyz/kit/schemas/finding.schema.json",
  "title": "Karukera finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "status",
    "impact",
    "exploitability",
    "confidence",
    "fix_effort",
    "visibility",
    "evidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^F-[0-9]{3}$",
      "description": "Identifiant local au projet."
    },
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 180
    },
    "status": {
      "type": "string",
      "enum": [
        "Confirmé",
        "Probable",
        "Hypothèse",
        "Non testé",
        "Mitigé",
        "Faux positif"
      ]
    },
    "fictif": {
      "type": "boolean",
      "default": false
    },
    "asset": {
      "type": "string"
    },
    "impact": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "I — gravité métier."
    },
    "exploitability": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "E — facilité observée, sans mode d'emploi d'attaque."
    },
    "confidence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "C — plafonné par le statut (voir allOf)."
    },
    "fix_effort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "F — effort de correctif ; abaisse la priorité."
    },
    "visibility": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "V — exposition de la surface."
    },
    "I": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Alias optionnel de impact. Si présent, égal à impact."
    },
    "E": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Alias optionnel de exploitability."
    },
    "C": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Alias optionnel de confidence."
    },
    "F": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Alias optionnel de fix_effort."
    },
    "V": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Alias optionnel de visibility."
    },
    "priority": {
      "type": "number",
      "description": "10*(0.30*I+0.25*E+0.20*C+0.15*V)-2*F"
    },
    "band": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "P3"]
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/evidenceRef"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "Confirmé" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "url", "excerpt", "date"]
            }
          },
          "confidence": { "minimum": 1, "maximum": 5 }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "Probable" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "confidence": { "maximum": 3 }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "Hypothèse" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "confidence": { "maximum": 2 }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "Non testé" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "confidence": { "maximum": 1 }
        }
      }
    }
  ],
  "definitions": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^E-[0-9]{3}$"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "excerpt": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "method": {
          "type": "string"
        }
      }
    }
  }
}
