{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://karukera.xyz/kit/schemas/evidence.schema.json",
  "title": "Karukera evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "excerpt", "date", "method", "finding_ids"],
  "anyOf": [
    { "required": ["url"] },
    { "required": ["surface"] }
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^E-[0-9]{3}$"
    },
    "url": {
      "type": "string",
      "description": "URL exacte de l'observation."
    },
    "surface": {
      "type": "string",
      "description": "Surface nommée si l'URL ne suffit pas (cookie, tool MCP, path:ligne)."
    },
    "excerpt": {
      "type": "string",
      "minLength": 3,
      "description": "Texte réellement vu, secrets masqués. Pas de payload."
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "method": {
      "type": "string",
      "enum": [
        "GET",
        "HEAD",
        "OPTIONS",
        "lecture-js",
        "lecture-header",
        "lecture-manifest",
        "compte-test-documenté",
        "lecture-source"
      ]
    },
    "content_type": {
      "type": "string"
    },
    "http_status": {
      "type": "integer",
      "minimum": 0,
      "maximum": 599
    },
    "finding_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^F-[0-9]{3}$"
      }
    },
    "agent": {
      "type": "string"
    },
    "fictif": {
      "type": "boolean",
      "default": false
    }
  }
}
